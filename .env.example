# Your COCO API key. Create one at https://cocoapi.top (dashboard -> API keys).
# Never commit the filled-in value. Keep this file out of version control.
COCO_API_KEY=

# Default model used by the examples. Pick any ID from https://api.cocoapi.top/v1/models
# Example IDs: claude-fable-5.1, claude-haiku-4-5-20251001, agnes-3.0-flash
COCO_MODEL=claude-fable-5.1
